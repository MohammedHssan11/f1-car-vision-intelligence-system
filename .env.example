# Copy to .env and adjust as needed:  cp .env.example .env
# docker compose reads these automatically.

# CORS allow-list (comma-separated). Add your host origin if not localhost.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Pipeline tuning (all optional; defaults shown) ---
# Stride for batched damage inference on tracked cars. Lower = finer, slower.
DAMAGE_EVERY_N_FRAMES=10
# Safety cap on frames processed per video.
MAX_FRAMES=3000
# Output video FourCC codec. mp4v is bundled + browser-safe.
# Set to avc1 only if your OpenCV build ships H.264.
PIPELINE_VIDEO_CODEC=mp4v
# Detection/classification confidence thresholds (optional).
PIPELINE_CONF_TH=0.4
PIPELINE_DAMAGE_CONF_TH=0.4
PIPELINE_TEAM_CONF_TH=0.6
