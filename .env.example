# Copy to .env and adjust as needed:  cp .env.example .env
# docker compose reads these automatically.

# CORS allow-list (comma-separated). Add your host origin if not localhost.
# Host port used by Docker. 8010 avoids collisions with other local FastAPI apps.
F1_APP_PORT=8010
ALLOWED_ORIGINS=http://localhost:8010,http://127.0.0.1:8010

# --- Pipeline tuning (all optional; defaults shown) ---
# Stride for batched damage inference on tracked cars. Lower = finer, slower.
DAMAGE_EVERY_N_FRAMES=10
# Safety cap on frames processed per video.
MAX_FRAMES=3000
# OpenCV intermediate FourCC. The final website video is always transcoded
# to browser-compatible H.264/AAC by ffmpeg.
PIPELINE_VIDEO_CODEC=mp4v
# Lower CRF = higher H.264 quality/larger output. 23 is a balanced default.
PIPELINE_H264_CRF=23
# Show per-car pixel speed labels in the annotated video (off avoids clutter).
PIPELINE_SHOW_SPEED=false
# Detection/classification confidence thresholds (optional).
PIPELINE_CONF_TH=0.4
PIPELINE_DAMAGE_CONF_TH=0.4
PIPELINE_TEAM_CONF_TH=0.6

# --- Tracking reliability (all optional; conservative defaults shown) ---
# Maximum lost-frame gap eligible for a conservative stable-ID reassociation.
TRACK_REASSOCIATION_MAX_GAP=30
# Lower is stricter; ambiguous candidate matches are always rejected.
TRACK_REASSOCIATION_MAX_SCORE=1.4
# A track older than this is excluded from current-frame overlays/damage work.
TRACK_ACTIVE_MAX_AGE=5

# --- Collision evidence (all optional; units are pixels/second and pixels/second²) ---
COLLISION_DECEL_THRESHOLD=-1500
COLLISION_MIN_PREIMPACT_SPEED=250
# Defaults must span at least two damage-inference strides.
COLLISION_DAMAGE_LOOKBACK_FRAMES=30
COLLISION_MIN_DAMAGE_OBSERVATIONS=2
